# Docker Compose needs no .env for the default localhost installation.
# Optional Docker overrides (change both together):
# LOCAL_HTTP_PORT=8080
# LOCAL_APP_ORIGIN=http://localhost:8080
# The values below are for native development only.
# Copy to .env; set unique local credentials. Never commit .env.
DATABASE_URL=mysql://recce_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:3307/recce_dev
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# Fictional development only. Do not enable in production.
SEED_FICTIONAL=false
DEMO_ADMIN_PASSWORD=
