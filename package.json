{
  "name": "recce-squad",
  "version": "1.0.0",
  "description": "RECCE officers personnel management system",
  "scripts": {
    "test": "node tools/design.test.cjs && node --test tools/mariadb-recovery.test.cjs tools/workbook-import.test.cjs && tsx backend/tests/unit.test.ts",
    "schema:validate": "node tools/validate-schema.cjs",
    "workbook:analyze": "node tools/analyze-workbook.cjs",
    "test:integration": "tsx backend/tests/integration.test.ts && tsx backend/tests/officers.test.ts && tsx backend/tests/organization.test.ts",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json",
    "build": "tsc -p backend/tsconfig.json && npm run build:frontend",
    "dev": "tsx backend/src/server.ts",
    "start": "node backend/dist/src/server.js",
    "db:generate": "node tools/generate-client-native.cjs",
    "db:migrate": "tsx tools/migrate.ts",
    "db:seed": "tsx backend/prisma/seed.ts",
    "db:migrate:test": "tsx tools/migrate.ts --test",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "typecheck:frontend": "tsc -p frontend/tsconfig.json",
    "test:browser": "playwright test --config frontend/playwright.config.ts",
    "test:browser:server": "node frontend/tests/server.cjs",
    "local:configure": "node tools/native-configure.cjs",
    "local:start": "node tools/native-launch.cjs",
    "local:access": "node tools/native-launch.cjs --access",
    "local:build": "npm run db:generate && npm run schema:validate && npm run build",
    "db:recover:mariadb": "tsx tools/migrate.ts --recover-mariadb-constraints",
    "workbook:import": "tsx tools/import-workbook.ts",
    "test:workbook:integration": "tsx backend/tests/workbook-import.test.ts",
    "typecheck:import": "tsc --noEmit --target es2022 --module nodenext --esModuleInterop --skipLibCheck --types node tools/import-workbook.ts",
    "db:seed:workbook": "node tools/seed-workbook.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimwanjiru/recce-squad.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jimwanjiru/recce-squad/issues"
  },
  "homepage": "https://github.com/jimwanjiru/recce-squad#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/internals": "6.19.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "exceljs": "^4.4.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@prisma/adapter-mariadb": "6.19.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.0",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.64.0",
    "mariadb": "^3.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "$mariadb"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
